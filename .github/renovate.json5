{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // The shared base stack lives in renovate-central.json5 (global config,
  // layered UNDER this file - also for this repository itself when the
  // sweeper runs it). Only repository-specific settings stay here.
  customManagers: [
    {
      // Track the Renovate version pins used in renovate.yml and
      // renovate-validate.yml (one renovate PR bumps them together)
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate.yml', '.github/workflows/renovate-validate.yml'],
      matchStrings: ["renovate-version:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
  ],
}
